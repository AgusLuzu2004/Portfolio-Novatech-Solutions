@startuml diagrama_secuencias

actor Usuario

Usuario -> VentaController : Confirmar venta (carrito con N productos)

VentaController -> VentaService : registrarVenta(venta)

VentaService -> VentaService : validarVenta()\n(cliente, empleado, al menos 1 producto...)

VentaService -> VentaService : verificarStock()\n(por cada producto del carrito)

VentaService -> VentaService : calcularSubtotales() / calcularTotal()

VentaService -> VentaDAO : registrarVenta(venta)

VentaDAO -> MySQL : setAutoCommit(false)

loop por cada producto del carrito
    VentaDAO -> MySQL : INSERT INTO ventas\n(una fila por producto)
    VentaDAO -> MySQL : UPDATE productos\nSET stock = stock - cantidad\nWHERE stock >= cantidad
    alt no había stock suficiente
        VentaDAO -> MySQL : ROLLBACK
        VentaDAO --> VentaService : false
    end
end

VentaDAO -> MySQL : COMMIT

MySQL --> VentaDAO : OK

VentaDAO --> VentaService : true

VentaService --> VentaController : true

VentaController --> Usuario : Mostrar éxito

@enduml