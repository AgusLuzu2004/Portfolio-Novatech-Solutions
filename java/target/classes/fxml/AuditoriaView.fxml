<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.novatech.controller.AuditoriaController">

    <top>

        <Label text="Auditoría del Sistema"
               style="-fx-font-size:20px; -fx-font-weight:bold;">

            <BorderPane.margin>
                <Insets top="15" bottom="15" left="20"/>
            </BorderPane.margin>

        </Label>

    </top>

    <center>

        <VBox spacing="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <HBox spacing="10">

                <Label text="Usuario:"/>

                <ComboBox fx:id="cmbUsuario"
                          prefWidth="180"/>

                <Label text="Módulo:"/>

                <ComboBox fx:id="cmbModulo"
                          prefWidth="180"/>

                <Label text="Desde:"/>

                <DatePicker fx:id="dpInicio"/>

                <Label text="Hasta:"/>

                <DatePicker fx:id="dpFin"/>

                <Button text="Buscar"
                        onAction="#buscar"/>

                <Button text="Limpiar"
                        onAction="#limpiarFiltros"/>

            </HBox>

            <TableView fx:id="tablaAuditoria">

                <columns>

                    <TableColumn fx:id="colUsuario"
                                 text="Usuario"
                                 prefWidth="130"/>

                    <TableColumn fx:id="colAccion"
                                 text="Acción"
                                 prefWidth="120"/>

                    <TableColumn fx:id="colModulo"
                                 text="Módulo"
                                 prefWidth="150"/>

                    <TableColumn fx:id="colDescripcion"
                                 text="Descripción"
                                 prefWidth="350"/>

                    <TableColumn fx:id="colFecha"
                                 text="Fecha"
                                 prefWidth="180"/>

                </columns>

            </TableView>

        </VBox>

    </center>

    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT">

            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <Button text="Exportar Excel"
                    onAction="#exportarExcel"/>

            <Button text="Exportar PDF"
                    onAction="#exportarPDF"/>

        </HBox>

    </bottom>

</BorderPane>