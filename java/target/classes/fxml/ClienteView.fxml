<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.novatech.controller.ClienteController">

    <top>
        <VBox spacing="10" style="-fx-padding: 10;">

            <Label text="Gestión de Clientes"
                   style="-fx-font-size:20px; -fx-font-weight:bold;"/>

            <HBox spacing="10">

                <Label text="Buscar:"/>

                <TextField fx:id="txtBuscar"
                           promptText="Nombre o apellido"/>

                <Button text="Buscar"
                        onAction="#buscarCliente"/>

                <Label text="Provincia:"/>

                <ComboBox fx:id="cmbProvincia"
                          onAction="#filtrarProvincia"/>

            </HBox>

        </VBox>
    </top>

    <center>

        <TableView fx:id="tablaClientes">

            <columns>

                <TableColumn fx:id="colId" text="ID"/>

                <TableColumn fx:id="colNombre" text="Nombre"/>

                <TableColumn fx:id="colApellido" text="Apellido"/>

                <TableColumn fx:id="colEdad" text="Edad"/>

                <TableColumn fx:id="colProvincia" text="Provincia"/>

                <TableColumn fx:id="colCiudad" text="Ciudad"/>

            </columns>

        </TableView>

    </center>

    <bottom>

        <HBox spacing="10"
              alignment="CENTER"
              style="-fx-padding:10;">

            <Button fx:id="btnNuevo"
                    text="Nuevo"
                    onAction="#nuevoCliente"/>

            <Button fx:id="btnEditar"
                    text="Editar"
                    onAction="#editarCliente"/>

            <Button fx:id="btnEliminar"
                    text="Eliminar"
                    onAction="#eliminarCliente"/>

        </HBox>

    </bottom>

</BorderPane>