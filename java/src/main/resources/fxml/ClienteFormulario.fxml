<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.novatech.controller.ClienteFormularioController">

    <top>
        <Label text="Nuevo Cliente"
               style="-fx-font-size:20px; -fx-font-weight:bold;">
            <BorderPane.margin>
                <Insets top="15" bottom="15" left="20"/>
            </BorderPane.margin>
        </Label>
    </top>

    <center>

        <GridPane hgap="15" vgap="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Nombre:" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
            <TextField fx:id="txtNombre"
                       promptText="Ingrese el nombre"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0"/>

            <Label text="Apellido:" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
            <TextField fx:id="txtApellido"
                       promptText="Ingrese el apellido"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="1"/>

            <Label text="Edad:" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
            <TextField fx:id="txtEdad"
                       promptText="Edad"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="2"/>

            <Label text="Sexo:" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
            <ComboBox fx:id="cmbSexo"
                      prefWidth="250"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="3"/>

            <Label text="Provincia:" GridPane.columnIndex="0" GridPane.rowIndex="4"/>
            <ComboBox fx:id="cmbProvincia"
                      prefWidth="250"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="4"/>

            <Label text="Ciudad:" GridPane.columnIndex="0" GridPane.rowIndex="5"/>
            <TextField fx:id="txtCiudad"
                       promptText="Ingrese la ciudad"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="5"/>

            <Label text="Fecha Alta:" GridPane.columnIndex="0" GridPane.rowIndex="6"/>
            <DatePicker fx:id="dpFechaAlta"
                        GridPane.columnIndex="1"
                        GridPane.rowIndex="6"/>

        </GridPane>

    </center>

    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT">

            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <Button fx:id="btnGuardar"
                    text="Guardar"
                    onAction="#guardarCliente"/>

            <Button fx:id="btnCancelar"
                    text="Cancelar"
                    onAction="#cancelar"/>

        </HBox>

    </bottom>

</BorderPane>