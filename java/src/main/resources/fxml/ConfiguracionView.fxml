<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx/21"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.novatech.controller.ConfiguracionController">

    <top>

        <Label text="Configuración del Sistema"
               style="-fx-font-size:20px; -fx-font-weight:bold;">

            <BorderPane.margin>
                <Insets top="15" bottom="15" left="20"/>
            </BorderPane.margin>

        </Label>

    </top>

    <center>

        <GridPane hgap="15"
                  vgap="15">

            <padding>
                <Insets top="20" right="20" bottom="20" left="20"/>
            </padding>

            <Label text="Empresa:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="0"/>

            <TextField fx:id="txtEmpresa"
                       GridPane.columnIndex="1"
                       GridPane.rowIndex="0"
                       prefWidth="300"/>

            <Label text="Moneda:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="1"/>

            <ComboBox fx:id="cmbMoneda"
                      GridPane.columnIndex="1"
                      GridPane.rowIndex="1"
                      prefWidth="200"/>

            <Label text="Color Principal:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="2"/>

            <ColorPicker fx:id="colorPrincipal"
                         GridPane.columnIndex="1"
                         GridPane.rowIndex="2"/>

            <Label text="Registros por página:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="3"/>

            <Spinner fx:id="spRegistros"
                     GridPane.columnIndex="1"
                     GridPane.rowIndex="3"
                     prefWidth="120"/>

            <Label text="Logo:"
                   GridPane.columnIndex="0"
                   GridPane.rowIndex="4"/>

            <HBox spacing="10"
                  GridPane.columnIndex="1"
                  GridPane.rowIndex="4">

                <TextField fx:id="txtLogo"
                           editable="false"
                           prefWidth="250"/>

                <Button text="Examinar"
                        onAction="#cambiarLogo"/>

            </HBox>

        </GridPane>

    </center>

    <bottom>

        <HBox spacing="15"
              alignment="CENTER_RIGHT">

            <padding>
                <Insets top="10" right="20" bottom="20" left="20"/>
            </padding>

            <Button text="Guardar"
                    onAction="#guardarConfiguracion"/>

            <Button text="Restaurar"
                    onAction="#restaurarValores"/>

            <Button text="Cancelar"
                    onAction="#cancelar"/>

        </HBox>

    </bottom>

</BorderPane>