<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.novatech.controller.ReporteController">

    <top>

        <VBox spacing="10" alignment="CENTER">

            <padding>
                <Insets top="15" bottom="15"/>
            </padding>

            <Label text="Reportes y Estadísticas"
                   style="-fx-font-size:24px;
                          -fx-font-weight:bold;"/>

            <HBox spacing="15" alignment="CENTER">

                <Label text="Año"/>

                <ComboBox fx:id="cbAnio"
                onAction="#filtrar"/>

                <Label text="Provincia"/>

                <ComboBox fx:id="cbProvincia"
                onAction="#filtrar"/>

                <Label text="Categoría"/>

                <ComboBox fx:id="cbCategoria"
                onAction="#filtrar"/>

                <Label text="Sucursal"/>

                <ComboBox fx:id="cbSucursal"
                onAction="#filtrar"/>

                <Button text="Actualizar"
                        onAction="#actualizar"/>

            </HBox>

        </VBox>

    </top>

    <center>

        <TabPane>

            <tabs>

                <Tab text="Dashboard">

                    <ScrollPane fitToWidth="true">

                        <VBox spacing="20">

                            <padding>
                                <Insets top="20"
                                        right="20"
                                        bottom="20"
                                        left="20"/>
                            </padding>

                            <GridPane hgap="20" vgap="20">

                                <Label text="Facturación"/>

                                <Label fx:id="lblFacturacion"
                                       GridPane.columnIndex="1"/>

                                <Label text="Ventas"
                                       GridPane.rowIndex="1"/>

                                <Label fx:id="lblVentas"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="1"/>

                                <Label text="Clientes"
                                       GridPane.rowIndex="2"/>

                                <Label fx:id="lblClientes"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="2"/>

                                <Label text="Productos"
                                       GridPane.rowIndex="3"/>

                                <Label fx:id="lblProductos"
                                       GridPane.columnIndex="1"
                                       GridPane.rowIndex="3"/>

                            </GridPane>

                        </VBox>

                    </ScrollPane>

                </Tab>

                <Tab text="Gráficos">

                    <ScrollPane fitToWidth="true">

                        <VBox spacing="30">

                            <padding>
                                <Insets top="20"
                                        right="20"
                                        bottom="20"
                                        left="20"/>
                            </padding>

                            <LineChart fx:id="lineVentasMensuales"
                                       title="Ventas Mensuales">

                                <xAxis>
                                    <CategoryAxis label="Mes"/>
                                </xAxis>

                                <yAxis>
                                    <NumberAxis label="Facturación"/>
                                </yAxis>

                            </LineChart>

                            <BarChart fx:id="barCategorias"
                                      title="Ventas por Categoría">

                                <xAxis>
                                    <CategoryAxis/>
                                </xAxis>

                                <yAxis>
                                    <NumberAxis/>
                                </yAxis>

                            </BarChart>

                            <BarChart fx:id="barProductos"
                                      title="Top Productos">

                                <xAxis>
                                    <CategoryAxis/>
                                </xAxis>

                                <yAxis>
                                    <NumberAxis/>
                                </yAxis>

                            </BarChart>

                            <BarChart fx:id="barEmpleados"
                                      title="Ranking Empleados">

                                <xAxis>
                                    <CategoryAxis/>
                                </xAxis>

                                <yAxis>
                                    <NumberAxis/>
                                </yAxis>

                            </BarChart>

                            <HBox spacing="20">

                                <PieChart fx:id="pieProvincias"
                                          title="Ventas por Provincia"/>

                                <PieChart fx:id="pieMediosPago"
                                          title="Medios de Pago"/>

                            </HBox>

                        </VBox>

                    </ScrollPane>

                </Tab>

                <Tab text="Resumen">

                    <BorderPane>

                        <center>

                            <TableView>

                                <columns>

                                    <TableColumn text="Indicador"/>

                                    <TableColumn text="Valor"/>

                                </columns>

                            </TableView>

                        </center>

                    </BorderPane>

                </Tab>

            </tabs>

        </TabPane>

    </center>

</BorderPane>