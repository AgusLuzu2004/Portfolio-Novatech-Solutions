<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="com.novatech.controller.BackupController">

    <top>

        <Label
                text="Copias de Seguridad"
                style="-fx-font-size: 24px; -fx-font-weight: bold;"
                BorderPane.alignment="CENTER"/>

    </top>

    <center>

        <VBox spacing="20"
              alignment="CENTER">

            <padding>

                <Insets top="30"
                        right="30"
                        bottom="30"
                        left="30"/>

            </padding>

            <Label
                    text="Administración de Backups"/>

            <HBox spacing="20"
                  alignment="CENTER">

                <Button
                        text="💾 Crear Backup"
                        onAction="#crearBackup"
                        prefWidth="220"
                        prefHeight="45"/>

                <Button
                        text="📂 Restaurar Backup"
                        onAction="#restaurarBackup"
                        prefWidth="220"
                        prefHeight="45"/>

            </HBox>

        </VBox>

    </center>

</BorderPane>